        "func": "const veh='car_02';\nconst light=flow.get('light_car02')||'RED';\nlet x=flow.get('x02')||Math.random()*20;let y=flow.get('y02')||Math.random()*20;let dir=flow.get('dir02')||(Math.random()<0.5?'E':'N');\nlet speed,status;if(light==='RED'){speed=0;status='Stopped';}else if(light==='YELLOW'){speed=10+Math.floor(Math.random()*21);status='Slowing';}else{speed=40+Math.floor(Math.random()*61);status='Moving';}\nif(speed>0){const step=speed/100.0;if(dir==='E')x+=step;else y+=step;if(Math.random()<0.05)dir=(dir==='E'?'N':'E');}\nx=Math.max(0,Math.min(100,x));y=Math.max(0,Math.min(100,y));flow.set('x02',x);flow.set('y02',y);flow.set('dir02',dir);\nconst payload={vehicle_id:veh,location:{x:Number(x.toFixed(3)),y:Number(y.toFixed(3))},speed,status,direction:dir,light,ts:Date.now()};\nreturn {topic:`vehicles/data/${veh}`,payload};",
