    {
        "id": "f37e31e8c0b09bc0",
        "type": "function",
        "z": "eb12423ff5842f3c",
        "name": "Split → table & chart",
        "func": "// const p=msg.payload; const tbl={payload:[p]}; const cht={topic:p.vehicle_id,payload:p.speed}; return [tbl,cht];  \n// --- Add geographic lat/lon that matches the map ---\n// Fixed inland bboxes (no sea):\n// car_01 -> Cairo downtown, car_02 -> Giza\nconst cityByVeh = {\n  car_01: { name: 'cairo', lat: [30.00, 30.09], lon: [31.20, 31.30] },\n  car_02: { name: 'giza',  lat: [29.97, 30.06], lon: [31.05, 31.20] }\n};\n\nconst p = msg.payload;\nconst city = cityByVeh[p.vehicle_id] || cityByVeh.car_01;\n\n// Map sim x/y (0..100) into bbox\nconst clamp = v => Math.max(0, Math.min(100, v));\nlet lon = city.lon[0] + (city.lon[1] - city.lon[0]) * (clamp(p.location.x) / 100);\nlet lat = city.lat[0] + (city.lat[1] - city.lat[0]) * (clamp(p.location.y) / 100);\n\n// Snap to ~100 m grid for road-ish motion\nconst snapLat = v => Math.round(v / 0.001) * 0.001; // ~111 m\nconst snapLon = v => Math.round(v / 0.001) * 0.001; // ~96 m near Cairo\nif (p.direction === 'E') lat = snapLat(lat); else lon = snapLon(lon);\n\n// Attach to payload so *everywhere* can reuse the same numbers\np.location.lat = Number(lat.toFixed(6));\np.location.lon = Number(lon.toFixed(6));\np.area = city.name; // optional, nice to show in table if you want\n\n// Keep your existing outputs\nconst tbl = { payload: [p] };\nconst cht = { topic: p.vehicle_id, payload: p.speed };\nreturn [tbl, cht];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
