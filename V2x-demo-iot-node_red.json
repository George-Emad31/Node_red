    {
        "id": "edd4349b8152e54a",
        "type": "function",
        "z": "eb12423ff5842f3c",
        "name": "Traffic Light: cycle + overrides",
        "func": "const D={RED:10,GREEN:10,YELLOW:3};\nlet mode=context.get('mode')||'AUTO';\nlet light=context.get('light')||'RED';\nlet remain=context.get('remain');\nif(msg.mode) mode=msg.mode;\nif(msg.light){light=String(msg.light);remain=D[light];}\nif(mode==='AUTO'){\n  if(typeof remain!=='number') remain=D[light];\n  remain-=1;\n  if(remain<=0){const order=['RED','GREEN','YELLOW'];let i=order.indexOf(light);light=order[(i+1)%order.length];remain=D[light];}\n}\ncontext.set('mode',mode);context.set('light',light);context.set('remain',remain);\nconst out={topic:'traffic/light/status',payload:{light,duration:remain}};\nnode.status({fill:(light==='RED'?'red':light==='YELLOW'?'yellow':'green'),shape:'dot',text:`${light} (${remain||0}s) ${mode}`});\nreturn [out,{payload:{light,remain,mode}}];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
