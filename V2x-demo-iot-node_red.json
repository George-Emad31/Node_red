    {
        "id": "to_egypt_map",
        "type": "function",
        "z": "eb12423ff5842f3c",
        "name": "x/y → lat/lon (Egypt) + marker",
        "func": "// Each car gets a different inland bbox so markers never appear in the sea.\n// car_01 -> Cairo (downtown area), car_02 -> Giza (inland).\nconst cityByVeh = {\n  car_01: { name: 'cairo', lat: [30.00, 30.09], lon: [31.20, 31.30] },\n  car_02: { name: 'giza', lat: [29.97, 30.06], lon: [31.05, 31.20] }\n};\n\n// Read lat/lon if the upstream function already set them; otherwise compute.\nconst p = msg.payload || {};\nif (!p.location) return null;\n\nlet lat = (typeof p.location.lat === 'number') ? p.location.lat : undefined;\nlet lon = (typeof p.location.lon === 'number') ? p.location.lon : undefined;\n\nif (typeof lat !== 'number' || typeof lon !== 'number') {\n  // Fallback (same bbox + snapping so it still matches)\n  const cityByVeh = {\n    car_01: { name: 'cairo', lat: [30.00, 30.09], lon: [31.20, 31.30] },\n    car_02: { name: 'giza', lat: [29.97, 30.06], lon: [31.05, 31.20] }\n  };\n  const city = cityByVeh[p.vehicle_id] || cityByVeh.car_01;\n  const clamp = v => Math.max(0, Math.min(100, v));\n  lon = city.lon[0] + (city.lon[1] - city.lon[0]) * (clamp(p.location.x) / 100);\n  lat = city.lat[0] + (city.lat[1] - city.lat[0]) * (clamp(p.location.y) / 100);\n  const snapLat = v => Math.round(v / 0.001) * 0.001;\n  const snapLon = v => Math.round(v / 0.001) * 0.001;\n  if (p.direction === 'E') lat = snapLat(lat); else lon = snapLon(lon);\n}\n\n// Short breadcrumb trail per vehicle\nconst tkey = `track_${p.vehicle_id}`;\nlet track = flow.get(tkey) || [];\ntrack.push([lat, lon]);\nif (track.length > 40) track.shift();\nflow.set(tkey, track);\n\n// Marker styling\nconst iconColor = p.speed === 0 ? \"#d32f2f\" : (p.light === \"YELLOW\" ? \"#f9a825\" : \"#2e7d32\");\nconst bearing = p.direction === 'E' ? 90 : 0;\n\nmsg.payload = {\n  name: p.vehicle_id,\n  lat, lon,\n  layer: \"Vehicles\",\n  icon: \"car\",\n  iconColor,\n  bearing,\n  speed: p.speed,\n  popup: `${p.vehicle_id}<br>Speed: ${p.speed} km/h<br>Light: ${p.light}<br>Dir: ${p.direction}${p.area ? `<br>Area: ${p.area}` : ''}`,\n  path: track\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 820,
